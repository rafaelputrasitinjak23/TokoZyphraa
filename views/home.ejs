<%- include('partials/header') %>
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">ECOMMERCE DIGITAL TERPERCAYA</span>
      <h1>Temukan Produk <span>Terbaik</span> untuk Kebutuhanmu</h1>
      <p>Belanja lebih praktis dengan promo flash sale, voucher eksklusif, dompet pengguna, dan pembayaran instan melalui Pakasir.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#catalog">Mulai Belanja</a>
        <% if (!currentUser) { %><a class="btn btn-ghost" href="/auth/register">Buat Akun Gratis</a><% } %>
      </div>
      <div class="trust-row">
        <span>✓ Pembayaran terverifikasi</span><span>✓ Produk digital instan</span><span>✓ Ulasan pembeli</span>
      </div>
    </div>
    <div class="hero-panel glass-card">
      <div class="orb"></div>
      <span class="panel-tag">TokoZyphra Benefits</span>
      <h2>Promo lebih besar. Checkout lebih cepat.</h2>
      <div class="feature-mini-grid">
        <div><strong>24/7</strong><span>Akses produk</span></div>
        <div><strong>100%</strong><span>Transparan</span></div>
        <div><strong>QRIS</strong><span>Bayar instan</span></div>
        <div><strong>OTP</strong><span>Akun aman</span></div>
      </div>
    </div>
  </div>
</section>

<% if (flashSaleProducts.length) { %>
<section class="section flash-section">
  <div class="container">
    <div class="section-heading"><div><span class="eyebrow danger">FLASH SALE</span><h2>Penawaran waktu terbatas</h2></div><div class="countdown" data-countdown="<%= new Date(flashSaleProducts[0].flashSaleEnd).toISOString() %>"><b data-hours>00</b><span>:</span><b data-minutes>00</b><span>:</span><b data-seconds>00</b></div></div>
    <div class="product-grid compact-grid">
      <% flashSaleProducts.forEach((product) => { %><%- include('partials/product-card', { product }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section" id="catalog">
  <div class="container">
    <div class="section-heading">
      <div><span class="eyebrow">KATALOG</span><h2>Produk pilihan TokoZyphra</h2></div>
    </div>
    <form class="catalog-filter glass-card" method="get" action="/">
      <input type="search" name="q" value="<%= search %>" placeholder="Cari produk..." aria-label="Cari produk">
      <select name="category" aria-label="Pilih kategori">
        <option value="">Semua kategori</option>
        <% categories.forEach((item) => { %><option value="<%= item %>" <%= category === item ? 'selected' : '' %>><%= item %></option><% }) %>
      </select>
      <button class="btn btn-primary" type="submit">Cari</button>
    </form>
    <% if (products.length) { %>
      <div class="product-grid">
        <% products.forEach((product) => { %><%- include('partials/product-card', { product }) %><% }) %>
      </div>
    <% } else { %>
      <div class="empty-state glass-card"><h3>Produk tidak ditemukan</h3><p>Coba gunakan kata kunci atau kategori yang berbeda.</p></div>
    <% } %>
  </div>
</section>

<section class="section" id="faq">
  <div class="container narrow">
    <div class="section-heading centered"><div><span class="eyebrow">FAQ</span><h2>Pertanyaan yang sering ditanyakan</h2></div></div>
    <div class="faq-list">
      <details><summary>Bagaimana produk diterima setelah pembayaran?</summary><p>Setelah pembayaran terverifikasi, detail produk digital dapat dilihat pada halaman detail pesanan di dashboard pengguna.</p></details>
      <details><summary>Bagaimana cara memakai voucher?</summary><p>Masukkan kode voucher pada halaman checkout. Sistem memvalidasi masa aktif, batas pemakaian, dan minimal pembelian secara otomatis.</p></details>
      <details><summary>Apakah tersedia produk gratis?</summary><p>Ya. Produk dengan harga nol dapat diselesaikan langsung tanpa membuka kanal pembayaran.</p></details>
      <details><summary>Apakah saldo dompet dapat dipakai?</summary><p>Saldo dompet dapat mengurangi total tagihan, termasuk membayar seluruh transaksi apabila saldo mencukupi.</p></details>
    </div>
  </div>
</section>

<section class="section cta-section">
  <div class="container cta-card">
    <div><span class="eyebrow">MULAI SEKARANG</span><h2>Belanja cepat, aman, dan mudah.</h2><p>Buat akun dan nikmati penawaran eksklusif dari TokoZyphra.</p></div>
    <a class="btn btn-light" href="<%= currentUser ? '/account' : '/auth/register' %>"><%= currentUser ? 'Buka Dashboard' : 'Daftar Sekarang' %></a>
  </div>
</section>
<%- include('partials/footer') %>
