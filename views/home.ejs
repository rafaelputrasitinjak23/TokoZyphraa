<%- include('partials/header') %>
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">ECOMMERCE DIGITAL TERPERCAYA</span>
      <h1>Temukan Produk <span>Terbaik</span> untuk Kebutuhanmu</h1>
      <p>Belanja lebih praktis dengan promo flash sale, voucher eksklusif, dompet pengguna, dan pembayaran instan melalui Pakasir.</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-icon-label" href="#catalog"><svg class="svg-icon" aria-hidden="true"><use href="#icon-store"></use></svg><span>Mulai Belanja</span></a>
        <% if (!currentUser) { %><a class="btn btn-ghost btn-icon-label" href="/auth/register"><svg class="svg-icon" aria-hidden="true"><use href="#icon-user"></use></svg><span>Buat Akun Gratis</span></a><% } %>
      </div>
      <div class="trust-row">
        <span><svg class="svg-icon" aria-hidden="true"><use href="#icon-shield-check"></use></svg>Pembayaran terverifikasi</span><span><svg class="svg-icon" aria-hidden="true"><use href="#icon-zap"></use></svg>Produk digital instan</span><span><svg class="svg-icon" aria-hidden="true"><use href="#icon-star"></use></svg>Ulasan pembeli</span>
      </div>
    </div>
    <div class="hero-panel glass-card">
      <div class="orb"></div>
      <span class="panel-tag">TokoRafael Benefits</span>
      <h2>Promo lebih besar. Checkout lebih cepat.</h2>
      <div class="feature-mini-grid">
        <div><strong>24/7</strong><span>Akses produk</span></div>
        <div><strong>100%</strong><span>Transparan</span></div>
        <div><strong>QRIS</strong><span>Bayar instan</span></div>
        <div><strong>OTP</strong><span>Akun aman</span></div>
      </div>
    </div>
  </div>
</section>

<% if (flashSaleProducts.length) { %>
<section class="section flash-section">
  <div class="container">
    <div class="section-heading"><div><span class="eyebrow danger"><svg class="svg-icon" aria-hidden="true"><use href="#icon-zap"></use></svg>FLASH SALE</span><h2>Penawaran waktu terbatas</h2></div><div class="countdown" data-countdown="<%= new Date(flashSaleProducts[0].flashSaleEnd).toISOString() %>"><b data-hours>00</b><span>:</span><b data-minutes>00</b><span>:</span><b data-seconds>00</b></div></div>
    <div class="product-grid compact-grid">
      <% flashSaleProducts.forEach((product) => { %><%- include('partials/product-card', { product }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section" id="catalog">
  <div class="container">
    <div class="section-heading">
      <div><span class="eyebrow">KATALOG</span><h2>Produk pilihan TokoRafael</h2></div>
    </div>
    <form class="catalog-filter catalog-filter-advanced glass-card" method="get" action="/">
      <div class="search-input-wrap catalog-search-wide"><svg class="svg-icon" aria-hidden="true"><use href="#icon-search"></use></svg><input type="search" name="q" value="<%= filters.search %>" placeholder="Cari nama, kategori, atau deskripsi..." aria-label="Cari produk"></div>
      <select name="category" aria-label="Pilih kategori"><option value="">Semua kategori</option><% categories.forEach((item) => { %><option value="<%= item %>" <%= filters.category === item ? 'selected' : '' %>><%= item %></option><% }) %></select>
      <select name="sort" aria-label="Urutkan produk"><option value="featured" <%= filters.sort === 'featured' ? 'selected' : '' %>>Unggulan</option><option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Terbaru</option><option value="popular" <%= filters.sort === 'popular' ? 'selected' : '' %>>Terlaris</option><option value="rating" <%= filters.sort === 'rating' ? 'selected' : '' %>>Rating tertinggi</option><option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Harga terendah</option><option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Harga tertinggi</option></select>
      <select name="rating" aria-label="Rating minimal"><option value="">Semua rating</option><option value="4" <%= filters.minimumRating === 4 ? 'selected' : '' %>>Minimal 4 bintang</option><option value="3" <%= filters.minimumRating === 3 ? 'selected' : '' %>>Minimal 3 bintang</option><option value="2" <%= filters.minimumRating === 2 ? 'selected' : '' %>>Minimal 2 bintang</option><option value="1" <%= filters.minimumRating === 1 ? 'selected' : '' %>>Minimal 1 bintang</option></select>
      <input type="number" name="minPrice" min="0" value="<%= filters.minPrice ?? '' %>" placeholder="Harga minimum" aria-label="Harga minimum">
      <input type="number" name="maxPrice" min="0" value="<%= filters.maxPrice ?? '' %>" placeholder="Harga maksimum" aria-label="Harga maksimum">
      <label class="check-row catalog-stock-filter"><input type="checkbox" name="availability" value="in_stock" <%= filters.availability === 'in_stock' ? 'checked' : '' %>><span>Stok tersedia</span></label>
      <div class="catalog-filter-actions"><button class="btn btn-primary btn-icon-label" type="submit"><svg class="svg-icon" aria-hidden="true"><use href="#icon-search"></use></svg><span>Terapkan</span></button><a class="btn btn-ghost" href="/#catalog">Reset</a></div>
    </form>
    <% if (products.length) { %>
      <div class="product-grid">
        <% products.forEach((product) => { %><%- include('partials/product-card', { product }) %><% }) %>
      </div>
    <% } else { %>
      <div class="empty-state glass-card"><h3>Produk tidak ditemukan</h3><p>Coba gunakan kata kunci atau kategori yang berbeda.</p></div>
    <% } %>
  </div>
</section>

<section class="section" id="faq">
  <div class="container narrow">
    <div class="section-heading centered"><div><span class="eyebrow">FAQ</span><h2>Pertanyaan yang sering ditanyakan</h2></div></div>
    <div class="faq-list">
      <details><summary>Bagaimana produk diterima setelah pembayaran?</summary><p>Setelah pembayaran terverifikasi, detail produk digital dapat dilihat pada halaman detail pesanan di dashboard pengguna.</p></details>
      <details><summary>Bagaimana cara memakai voucher?</summary><p>Masukkan kode voucher pada halaman checkout. Sistem memvalidasi masa aktif, batas pemakaian, dan minimal pembelian secara otomatis.</p></details>
      <details><summary>Apakah tersedia produk gratis?</summary><p>Ya. Produk dengan harga nol dapat diselesaikan langsung tanpa membuka kanal pembayaran.</p></details>
      <details><summary>Apakah saldo dompet dapat dipakai?</summary><p>Saldo dompet dapat mengurangi total tagihan, termasuk membayar seluruh transaksi apabila saldo mencukupi.</p></details>
    </div>
  </div>
</section>

<div class="container"><%- include('partials/pagination', { pagination }) %></div>
<section class="section cta-section">
  <div class="container cta-card">
    <div><span class="eyebrow">MULAI SEKARANG</span><h2>Belanja cepat, aman, dan mudah.</h2><p>Buat akun dan nikmati penawaran eksklusif dari TokoRafael.</p></div>
    <a class="btn btn-light" href="<%= currentUser ? '/account' : '/auth/register' %>"><%= currentUser ? 'Buka Dashboard' : 'Daftar Sekarang' %></a>
  </div>
</section>
<%- include('partials/footer') %>
