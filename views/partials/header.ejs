<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content="TokoZyphra - marketplace produk digital, promo, voucher, dompet, dan pembayaran praktis.">
  <meta name="theme-color" content="#ffffff">
  <title><%= title ? `${title} | ${appName}` : appName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=20260626-admin-as-user-1">
</head>
<body class="<%= isAdmin ? 'admin-shell' : 'market-shell' %><%= currentUser && !isAdmin ? ' has-mobile-market-nav' : '' %>">
  <%- include('icon-sprite') %>
  <div class="ambient ambient-one"></div>
  <div class="ambient ambient-two"></div>

  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand" href="/" aria-label="Beranda TokoZyphra">
        <span class="brand-mark">Z</span>
        <span>Toko<span>Zyphra</span></span>
      </a>

      <nav class="main-nav" aria-label="Navigasi utama desktop">
        <% if (isAdmin) { %>
          <a class="<%= currentPath === '/admin' ? 'active' : '' %>" href="/admin">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-dashboard"></use></svg>
            <span>Admin</span>
          </a>
          <a class="<%= currentPath.startsWith('/admin/products') ? 'active' : '' %>" href="/admin/products">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-package"></use></svg>
            <span>Produk</span>
          </a>
          <a class="<%= currentPath.startsWith('/admin/orders') ? 'active' : '' %>" href="/admin/orders">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-cart"></use></svg>
            <span>Pesanan</span>
          </a>
          <a class="<%= currentPath.startsWith('/admin/users') ? 'active' : '' %>" href="/admin/users">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-user"></use></svg>
            <span>Pengguna</span>
          </a>
          <a class="<%= currentPath.startsWith('/admin/topups') ? 'active' : '' %>" href="/admin/topups">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-wallet"></use></svg>
            <span>Top Up</span>
          </a>
        <% } else { %>
          <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/#catalog">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-store"></use></svg>
            <span>Produk</span>
          </a>
          <% if (currentUser) { %>
            <a class="<%= currentPath === '/account' || currentPath === '/account/profile' ? 'active' : '' %>" href="/account">
              <svg class="svg-icon" aria-hidden="true"><use href="#icon-dashboard"></use></svg>
              <span>Dashboard</span>
            </a>
            <a class="<%= currentPath.startsWith('/account/orders') ? 'active' : '' %>" href="/account/orders">
              <svg class="svg-icon" aria-hidden="true"><use href="#icon-package"></use></svg>
              <span>Pesanan</span>
            </a>
            <a class="<%= currentPath.startsWith('/account/wallet') ? 'active' : '' %>" href="/account/wallet">
              <svg class="svg-icon" aria-hidden="true"><use href="#icon-wallet"></use></svg>
              <span>Dompet</span>
            </a>
          <% } %>
          <% if (canAccessAdmin) { %>
            <a href="/admin">
              <svg class="svg-icon" aria-hidden="true"><use href="#icon-dashboard"></use></svg>
              <span>Admin</span>
            </a>
          <% } %>
        <% } %>
      </nav>

      <div class="nav-actions">
        <% if (!isAdmin) { %>
          <a class="cart-link" href="/cart" aria-label="Keranjang, <%= cartCount %> produk">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-cart"></use></svg>
            <span class="cart-link-label">Keranjang</span>
            <% if (cartCount > 0) { %><b><%= cartCount %></b><% } %>
          </a>
        <% } %>

        <% if (!currentUser) { %>
          <a class="btn btn-ghost btn-sm" href="/auth/login">Masuk</a>
          <a class="btn btn-primary btn-sm" href="/auth/register">Daftar</a>
        <% } else { %>
          <a class="user-chip <%= canAccessAdmin ? 'admin-chip' : '' %>" href="/account" aria-label="Buka dashboard <%= currentUser.name %>">
            <span class="user-chip-avatar">
              <% if (currentUser.hasAvatar) { %>
                <img src="/account/avatar" alt="">
              <% } else { %>
                <%= currentUser.name.slice(0, 1).toUpperCase() %>
              <% } %>
            </span>
            <span class="user-chip-name"><%= currentUser.name %></span>
          </a>
          <form method="post" action="/auth/logout" class="inline-form header-logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-ghost btn-sm btn-icon-label" type="submit">
              <svg class="svg-icon" aria-hidden="true"><use href="#icon-logout"></use></svg>
              <span>Keluar</span>
            </button>
          </form>
        <% } %>
      </div>

      <button
        class="nav-toggle"
        type="button"
        aria-label="Buka menu"
        aria-controls="responsive-menu"
        aria-expanded="false"
        data-responsive-menu-toggle
      >
        <svg class="svg-icon" aria-hidden="true"><use href="#icon-menu"></use></svg>
      </button>
    </div>
  </header>

  <div class="responsive-menu-overlay" data-responsive-menu-close hidden></div>
  <aside
    class="responsive-menu-drawer"
    id="responsive-menu"
    aria-label="Menu mobile dan tablet"
    aria-hidden="true"
    aria-modal="true"
    role="dialog"
    data-responsive-menu
  >
    <div class="responsive-menu-header">
      <div class="responsive-menu-identity">
        <% if (currentUser) { %>
          <span class="responsive-menu-avatar">
            <% if (currentUser.hasAvatar) { %>
              <img src="/account/avatar" alt="">
            <% } else { %>
              <%= currentUser.name.slice(0, 1).toUpperCase() %>
            <% } %>
          </span>
          <span>
            <strong><%= currentUser.name %></strong>
            <small><%= canAccessAdmin ? 'Pengguna & Administrator' : 'Akun pengguna' %></small>
          </span>
        <% } else { %>
          <span class="responsive-menu-avatar guest-avatar">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-user"></use></svg>
          </span>
          <span>
            <strong>Selamat datang</strong>
            <small>Masuk untuk mengakses akun</small>
          </span>
        <% } %>
      </div>
      <button class="responsive-menu-close" type="button" aria-label="Tutup menu" data-responsive-menu-close>
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <nav class="responsive-menu-links" aria-label="Navigasi mobile dan tablet">
      <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/#catalog">
        <span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-store"></use></svg></span>
        <span><strong>Produk</strong><small>Lihat katalog marketplace</small></span>
        <svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg>
      </a>

      <a class="<%= currentPath === '/cart' || currentPath.startsWith('/checkout') ? 'active' : '' %>" href="/cart">
        <span class="responsive-menu-link-icon">
          <svg class="svg-icon" aria-hidden="true"><use href="#icon-cart"></use></svg>
          <% if (cartCount > 0) { %><b><%= cartCount > 99 ? '99+' : cartCount %></b><% } %>
        </span>
        <span><strong>Keranjang</strong><small>Produk yang akan dibeli</small></span>
        <svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg>
      </a>

      <% if (currentUser) { %>
        <a class="<%= currentPath.startsWith('/account/wallet') ? 'active' : '' %>" href="/account/wallet">
          <span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-wallet"></use></svg></span>
          <span><strong>Dompet</strong><small>Saldo dan riwayat transaksi</small></span>
          <svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg>
        </a>
        <a class="<%= currentPath.startsWith('/account/orders') ? 'active' : '' %>" href="/account/orders">
          <span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-package"></use></svg></span>
          <span><strong>Pesanan</strong><small>Status dan riwayat pembelian</small></span>
          <svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg>
        </a>
        <a class="<%= currentPath === '/account' || currentPath === '/account/profile' ? 'active' : '' %>" href="/account">
          <span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-user"></use></svg></span>
          <span><strong>Akun Saya</strong><small>Ringkasan dan log pesanan</small></span>
          <svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg>
        </a>
      <% } %>

      <% if (canAccessAdmin) { %>
        <a class="responsive-menu-admin-link <%= currentPath.startsWith('/admin') ? 'active' : '' %>" href="/admin">
          <span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-dashboard"></use></svg></span>
          <span><strong>Admin Control</strong><small>Kelola toko, pengguna, dan transaksi</small></span>
          <svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg>
        </a>
      <% } %>
    </nav>

    <div class="responsive-menu-footer">
      <% if (!currentUser) { %>
        <a class="btn btn-ghost" href="/auth/login">Masuk</a>
        <a class="btn btn-primary" href="/auth/register">Daftar</a>
      <% } else { %>
        <form method="post" action="/auth/logout" data-disable-on-submit>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="responsive-menu-logout" type="submit">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-logout"></use></svg>
            <span>Keluar dari akun</span>
          </button>
        </form>
      <% } %>
    </div>
  </aside>

  <% if (!isAdmin && currentUser) { %>
    <nav class="mobile-market-nav" aria-label="Navigasi utama mobile">
      <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/#catalog">
        <svg class="svg-icon" aria-hidden="true"><use href="#icon-store"></use></svg>
        <span>Produk</span>
      </a>
      <a class="<%= currentPath === '/cart' || currentPath.startsWith('/checkout') ? 'active' : '' %>" href="/cart">
        <span class="mobile-nav-icon">
          <svg class="svg-icon" aria-hidden="true"><use href="#icon-cart"></use></svg>
          <% if (cartCount > 0) { %><b><%= cartCount > 99 ? '99+' : cartCount %></b><% } %>
        </span>
        <span>Keranjang</span>
      </a>
      <a class="<%= currentPath.startsWith('/account/wallet') ? 'active' : '' %>" href="/account/wallet">
        <svg class="svg-icon" aria-hidden="true"><use href="#icon-wallet"></use></svg>
        <span>Dompet</span>
      </a>
      <a class="<%= currentPath.startsWith('/account/orders') ? 'active' : '' %>" href="/account/orders">
        <svg class="svg-icon" aria-hidden="true"><use href="#icon-package"></use></svg>
        <span>Pesanan</span>
      </a>
      <a class="<%= currentPath === '/account' || currentPath === '/account/profile' ? 'active' : '' %>" href="/account">
        <svg class="svg-icon" aria-hidden="true"><use href="#icon-user"></use></svg>
        <span>Akun</span>
      </a>
    </nav>
  <% } %>

  <main>
    <%- include('flash') %>
