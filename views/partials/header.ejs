<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content="TokoRafael - marketplace produk digital, promo, voucher, dompet, dan pembayaran praktis.">
  <meta name="theme-color" content="#ffffff">
  <title><%= title ? `${title} | ${appName}` : appName %></title>
  <link rel="icon" type="image/png" href="https://athars.space/uploads/a70f89fb.png">
  <link rel="apple-touch-icon" href="https://athars.space/uploads/a70f89fb.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="/js/intro-bootstrap.js?v=20260627-intro-1"></script>
  <link rel="stylesheet" href="/css/style.css?v=20260627-intro-1">
  <script src="/js/site-intro.js?v=20260627-intro-1" defer></script>
</head>
<body class="<%= isAdmin ? 'admin-shell' : 'market-shell' %><%= currentUser && !isAdmin ? ' has-mobile-market-nav' : '' %>">
  <div class="site-intro" data-site-intro aria-hidden="true" aria-label="Animasi pembuka TokoRafael">
    <video
      class="site-intro-video"
      data-site-intro-video
      autoplay
      muted
      playsinline
      preload="auto"
      poster="/images/tokorafael-intro-poster.jpg"
    >
      <source src="/media/tokorafael-intro.mp4" type="video/mp4">
    </video>
    <div class="site-intro-progress" aria-hidden="true"><span></span></div>
    <button class="site-intro-skip" type="button" data-site-intro-skip>
      Lewati
      <span aria-hidden="true">→</span>
    </button>
  </div>

  <%- include('icon-sprite') %>
  <div class="ambient ambient-one"></div>
  <div class="ambient ambient-two"></div>

  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand brand-header" href="/" aria-label="Beranda TokoRafael">
        <img
          class="brand-logo brand-logo-header"
          src="https://athars.space/uploads/8ae360ca.png"
          alt="TokoRafael"
          width="866"
          height="288"
          decoding="async"
          fetchpriority="high"
        >
      </a>

      <nav class="main-nav" aria-label="Navigasi utama desktop">
        <% if (isAdmin) { %>
          <% if (hasAdminPermission('analytics')) { %><a class="<%= currentPath === '/admin' ? 'active' : '' %>" href="/admin"><svg class="svg-icon" aria-hidden="true"><use href="#icon-dashboard"></use></svg><span>Analitik</span></a><% } %>
          <% if (hasAdminPermission('products')) { %><a class="<%= currentPath.startsWith('/admin/products') || currentPath.startsWith('/admin/serial-keys') ? 'active' : '' %>" href="/admin/products"><svg class="svg-icon" aria-hidden="true"><use href="#icon-package"></use></svg><span>Produk</span></a><% } %>
          <% if (hasAdminPermission('orders')) { %><a class="<%= currentPath.startsWith('/admin/orders') ? 'active' : '' %>" href="/admin/orders"><svg class="svg-icon" aria-hidden="true"><use href="#icon-cart"></use></svg><span>Pesanan</span></a><% } %>
          <% if (hasAdminPermission('users')) { %><a class="<%= currentPath.startsWith('/admin/users') ? 'active' : '' %>" href="/admin/users"><svg class="svg-icon" aria-hidden="true"><use href="#icon-user"></use></svg><span>Pengguna</span></a><% } %>
          <% if (hasAdminPermission('tickets')) { %><a class="<%= currentPath.startsWith('/admin/tickets') ? 'active' : '' %>" href="/admin/tickets"><svg class="svg-icon" aria-hidden="true"><use href="#icon-message"></use></svg><span>Tiket</span></a><% } %>
          <% if (hasAdminPermission('wallet')) { %><a class="<%= currentPath.startsWith('/admin/topups') ? 'active' : '' %>" href="/admin/topups"><svg class="svg-icon" aria-hidden="true"><use href="#icon-wallet"></use></svg><span>Top Up</span></a><% } %>
          <% if (hasAdminPermission('vouchers')) { %><a class="<%= currentPath.startsWith('/admin/vouchers') ? 'active' : '' %>" href="/admin/vouchers"><svg class="svg-icon" aria-hidden="true"><use href="#icon-tag"></use></svg><span>Voucher</span></a><% } %>
          <% if (hasAdminPermission('reviews')) { %><a class="<%= currentPath.startsWith('/admin/reviews') ? 'active' : '' %>" href="/admin/reviews"><svg class="svg-icon" aria-hidden="true"><use href="#icon-star"></use></svg><span>Ulasan</span></a><% } %>
        <% } else { %>
          <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/#catalog">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-store"></use></svg>
            <span>Produk</span>
          </a>
          <% if (currentUser) { %>
            <a class="<%= currentPath === '/account' || currentPath === '/account/profile' ? 'active' : '' %>" href="/account">
              <svg class="svg-icon" aria-hidden="true"><use href="#icon-dashboard"></use></svg>
              <span>Dashboard</span>
            </a>
            <a class="<%= currentPath.startsWith('/account/orders') ? 'active' : '' %>" href="/account/orders">
              <svg class="svg-icon" aria-hidden="true"><use href="#icon-package"></use></svg>
              <span>Pesanan</span>
            </a>
            <a class="<%= currentPath.startsWith('/account/wallet') ? 'active' : '' %>" href="/account/wallet">
              <svg class="svg-icon" aria-hidden="true"><use href="#icon-wallet"></use></svg>
              <span>Dompet</span>
            </a>
          <% } %>
          <% if (canAccessAdmin) { %>
            <a href="<%= adminHomePath %>">
              <svg class="svg-icon" aria-hidden="true"><use href="#icon-dashboard"></use></svg>
              <span>Admin</span>
            </a>
          <% } %>
        <% } %>
      </nav>

      <div class="nav-actions">
        <% if (!isAdmin) { %>
          <a class="cart-link" href="/cart" aria-label="Keranjang, <%= cartCount %> produk">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-cart"></use></svg>
            <span class="cart-link-label">Keranjang</span>
            <% if (cartCount > 0) { %><b><%= cartCount %></b><% } %>
          </a>
        <% } %>

        <% if (currentUser) { %>
          <a class="header-notification-link" href="/account/notifications" aria-label="Notifikasi, <%= notificationCount %> belum dibaca">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-bell"></use></svg>
            <% if (notificationCount > 0) { %><b><%= notificationCount > 99 ? '99+' : notificationCount %></b><% } %>
          </a>
        <% } %>

        <% if (!currentUser) { %>
          <a class="btn btn-ghost btn-sm" href="/auth/login">Masuk</a>
          <a class="btn btn-primary btn-sm" href="/auth/register">Daftar</a>
        <% } else { %>
          <a class="user-chip <%= canAccessAdmin ? 'admin-chip' : '' %>" href="/account" aria-label="Buka dashboard <%= currentUser.name %>">
            <span class="user-chip-avatar">
              <% if (currentUser.hasAvatar) { %>
                <img src="/account/avatar" alt="">
              <% } else { %>
                <%= currentUser.name.slice(0, 1).toUpperCase() %>
              <% } %>
            </span>
            <span class="user-chip-name"><%= currentUser.name %></span>
          </a>
          <form method="post" action="/auth/logout" class="inline-form header-logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-ghost btn-sm btn-icon-label" type="submit">
              <svg class="svg-icon" aria-hidden="true"><use href="#icon-logout"></use></svg>
              <span>Keluar</span>
            </button>
          </form>
        <% } %>
      </div>

      <button
        class="nav-toggle"
        type="button"
        aria-label="Buka menu"
        aria-controls="responsive-menu"
        aria-expanded="false"
        data-responsive-menu-toggle
      >
        <svg class="svg-icon" aria-hidden="true"><use href="#icon-menu"></use></svg>
      </button>
    </div>
  </header>

  <div class="responsive-menu-overlay" data-responsive-menu-close hidden></div>
  <aside
    class="responsive-menu-drawer"
    id="responsive-menu"
    aria-label="Menu mobile dan tablet"
    aria-hidden="true"
    aria-modal="true"
    role="dialog"
    data-responsive-menu
  >
    <div class="responsive-menu-header">
      <div class="responsive-menu-identity">
        <% if (currentUser) { %>
          <span class="responsive-menu-avatar">
            <% if (currentUser.hasAvatar) { %>
              <img src="/account/avatar" alt="">
            <% } else { %>
              <%= currentUser.name.slice(0, 1).toUpperCase() %>
            <% } %>
          </span>
          <span>
            <strong><%= currentUser.name %></strong>
            <small><%= canAccessAdmin ? 'Pengguna & Administrator' : 'Akun pengguna' %></small>
          </span>
        <% } else { %>
          <span class="responsive-menu-avatar guest-avatar">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-user"></use></svg>
          </span>
          <span>
            <strong>Selamat datang</strong>
            <small>Masuk untuk mengakses akun</small>
          </span>
        <% } %>
      </div>
      <button class="responsive-menu-close" type="button" aria-label="Tutup menu" data-responsive-menu-close>
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <nav class="responsive-menu-links" aria-label="Navigasi mobile dan tablet">
      <% if (isAdmin) { %>
        <% if (hasAdminPermission('analytics')) { %><a class="<%= currentPath === '/admin' ? 'active' : '' %>" href="/admin"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-dashboard"></use></svg></span><span><strong>Dashboard Analitik</strong><small>Ringkasan performa toko</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a><% } %>
        <% if (hasAdminPermission('products')) { %><a class="<%= currentPath.startsWith('/admin/products') || currentPath.startsWith('/admin/serial-keys') ? 'active' : '' %>" href="/admin/products"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-package"></use></svg></span><span><strong>Produk Digital</strong><small>File, link, stok, dan serial key</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a><% } %>
        <% if (hasAdminPermission('orders')) { %><a class="<%= currentPath.startsWith('/admin/orders') ? 'active' : '' %>" href="/admin/orders"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-cart"></use></svg></span><span><strong>Pesanan</strong><small>Kelola transaksi pelanggan</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a><% } %>
        <% if (hasAdminPermission('users')) { %><a class="<%= currentPath.startsWith('/admin/users') ? 'active' : '' %>" href="/admin/users"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-user"></use></svg></span><span><strong>Pengguna & Role</strong><small>Atur akun dan permission admin</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a><% } %>
        <% if (hasAdminPermission('wallet')) { %><a class="<%= currentPath.startsWith('/admin/topups') ? 'active' : '' %>" href="/admin/topups"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-wallet"></use></svg></span><span><strong>Dompet & Top Up</strong><small>Pemeriksaan transaksi saldo</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a><% } %>
        <% if (hasAdminPermission('tickets')) { %><a class="<%= currentPath.startsWith('/admin/tickets') ? 'active' : '' %>" href="/admin/tickets"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-message"></use></svg></span><span><strong>Tiket Bantuan</strong><small>Balas komplain pelanggan</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a><% } %>
        <% if (hasAdminPermission('vouchers')) { %><a class="<%= currentPath.startsWith('/admin/vouchers') ? 'active' : '' %>" href="/admin/vouchers"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-tag"></use></svg></span><span><strong>Voucher</strong><small>Kelola promo toko</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a><% } %>
        <% if (hasAdminPermission('reviews')) { %><a class="<%= currentPath.startsWith('/admin/reviews') ? 'active' : '' %>" href="/admin/reviews"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-star"></use></svg></span><span><strong>Ulasan</strong><small>Moderasi ulasan produk</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a><% } %>
        <a href="/account/notifications"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-bell"></use></svg><% if (notificationCount > 0) { %><b><%= notificationCount > 99 ? '99+' : notificationCount %></b><% } %></span><span><strong>Notifikasi Saya</strong><small>Pembaruan transaksi dan akun</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a>
        <a href="/"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-store"></use></svg></span><span><strong>Buka Marketplace</strong><small>Belanja sebagai pengguna</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a>
        <a href="/account"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-user"></use></svg></span><span><strong>Akun Saya</strong><small>Dashboard akun pengguna</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a>
      <% } else { %>
        <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/#catalog"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-store"></use></svg></span><span><strong>Produk</strong><small>Lihat katalog marketplace</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a>
        <a class="<%= currentPath === '/cart' || currentPath.startsWith('/checkout') ? 'active' : '' %>" href="/cart"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-cart"></use></svg><% if (cartCount > 0) { %><b><%= cartCount > 99 ? '99+' : cartCount %></b><% } %></span><span><strong>Keranjang</strong><small>Produk yang akan dibeli</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a>
        <% if (currentUser) { %>
          <a class="<%= currentPath.startsWith('/account/wishlist') ? 'active' : '' %>" href="/account/wishlist"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-heart"></use></svg></span><span><strong>Wishlist</strong><small>Produk yang Anda simpan</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a>
          <a class="<%= currentPath.startsWith('/account/notifications') ? 'active' : '' %>" href="/account/notifications"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-bell"></use></svg><% if (notificationCount > 0) { %><b><%= notificationCount > 99 ? '99+' : notificationCount %></b><% } %></span><span><strong>Notifikasi</strong><small>Pembaruan transaksi dan akun</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a>
          <a class="<%= currentPath.startsWith('/account/tickets') ? 'active' : '' %>" href="/account/tickets"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-message"></use></svg></span><span><strong>Bantuan & Komplain</strong><small>Hubungi tim admin</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a>
          <a class="<%= currentPath.startsWith('/account/wallet') ? 'active' : '' %>" href="/account/wallet"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-wallet"></use></svg></span><span><strong>Dompet</strong><small>Saldo dan riwayat transaksi</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a>
          <a class="<%= currentPath.startsWith('/account/orders') ? 'active' : '' %>" href="/account/orders"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-package"></use></svg></span><span><strong>Pesanan</strong><small>Status dan riwayat pembelian</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a>
          <a class="<%= currentPath === '/account' || currentPath === '/account/profile' ? 'active' : '' %>" href="/account"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-user"></use></svg></span><span><strong>Akun Saya</strong><small>Ringkasan dan log pesanan</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a>
        <% } %>
        <% if (canAccessAdmin) { %><a class="responsive-menu-admin-link" href="<%= adminHomePath %>"><span class="responsive-menu-link-icon"><svg class="svg-icon" aria-hidden="true"><use href="#icon-dashboard"></use></svg></span><span><strong>Admin Control</strong><small>Kelola toko dan transaksi</small></span><svg class="svg-icon responsive-menu-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></a><% } %>
      <% } %>
    </nav>

    <div class="responsive-menu-footer">
      <% if (!currentUser) { %>
        <a class="btn btn-ghost" href="/auth/login">Masuk</a>
        <a class="btn btn-primary" href="/auth/register">Daftar</a>
      <% } else { %>
        <form method="post" action="/auth/logout" data-disable-on-submit>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="responsive-menu-logout" type="submit">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-logout"></use></svg>
            <span>Keluar dari akun</span>
          </button>
        </form>
      <% } %>
    </div>
  </aside>

  <% if (!isAdmin && currentUser) { %>
    <nav class="mobile-market-nav" aria-label="Navigasi utama mobile">
      <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/#catalog">
        <svg class="svg-icon" aria-hidden="true"><use href="#icon-store"></use></svg>
        <span>Produk</span>
      </a>
      <a class="<%= currentPath === '/cart' || currentPath.startsWith('/checkout') ? 'active' : '' %>" href="/cart">
        <span class="mobile-nav-icon">
          <svg class="svg-icon" aria-hidden="true"><use href="#icon-cart"></use></svg>
          <% if (cartCount > 0) { %><b><%= cartCount > 99 ? '99+' : cartCount %></b><% } %>
        </span>
        <span>Keranjang</span>
      </a>
      <a class="<%= currentPath.startsWith('/account/wallet') ? 'active' : '' %>" href="/account/wallet">
        <svg class="svg-icon" aria-hidden="true"><use href="#icon-wallet"></use></svg>
        <span>Dompet</span>
      </a>
      <a class="<%= currentPath.startsWith('/account/orders') ? 'active' : '' %>" href="/account/orders">
        <svg class="svg-icon" aria-hidden="true"><use href="#icon-package"></use></svg>
        <span>Pesanan</span>
      </a>
      <a class="<%= currentPath === '/account' || currentPath === '/account/profile' ? 'active' : '' %>" href="/account">
        <svg class="svg-icon" aria-hidden="true"><use href="#icon-user"></use></svg>
        <span>Akun</span>
      </a>
    </nav>
  <% } %>

  <main>
    <%- include('flash') %>
