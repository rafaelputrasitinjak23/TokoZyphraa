<%- include('../partials/header') %>
<section class="section page-section"><div class="container"><div class="admin-heading"><div><span class="eyebrow">ADMIN / PESANAN</span><h1>Kelola Pesanan</h1></div><form method="get" action="/admin/orders" class="filter-inline"><select name="status" onchange="this.form.submit()"><option value="">Semua status</option><% ['pending','paid','completed','cancelled','expired','manual_review'].forEach((status) => { %><option value="<%= status %>" <%= selectedStatus === status ? 'selected' : '' %>><%= status %></option><% }) %></select></form></div><div class="table-card glass-card"><div class="responsive-table"><table><thead><tr><th>Pesanan</th><th>Pengguna</th><th>Nilai</th><th>Metode</th><th>Status</th><th>Ubah Status</th></tr></thead><tbody><% orders.forEach((order) => { %><tr><td><strong><%= order.orderNumber %></strong><small class="table-sub"><%= formatDate(order.createdAt) %></small></td><td><%= order.user?.name || '-' %><small class="table-sub"><%= order.user?.email || '' %></small></td><td><%= formatRupiah(order.payableAmount) %><small class="table-sub">Dompet: <%= formatRupiah(order.walletUsed) %></small></td><td><%= order.paymentMethod || '-' %></td><td><span class="status-pill status-<%= order.status %>"><%= order.status %></span></td><td><form method="post" action="/admin/orders/<%= order._id %>/status" class="action-row"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% ['pending','paid','completed','cancelled','expired','manual_review'].forEach((status) => { %><option value="<%= status %>" <%= order.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select><button class="btn btn-ghost btn-sm" type="submit">Simpan</button></form></td></tr><% }) %></tbody></table></div></div></div></section>
<%- include('../partials/footer') %>
