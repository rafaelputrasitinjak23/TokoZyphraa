<%- include('../../partials/header') %>
<section class="section page-section"><div class="container narrow-wide"><div class="section-heading"><div><span class="eyebrow">ADMIN / PRODUK</span><h1><%= product ? 'Edit Produk' : 'Tambah Produk' %></h1></div></div><form method="post" action="<%= action %>" class="form-card glass-card form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Nama produk<input type="text" name="name" required maxlength="140" value="<%= product?.name || '' %>"></label><label>Slug URL<input type="text" name="slug" maxlength="160" value="<%= product?.slug || '' %>" placeholder="otomatis dari nama"></label><label class="full">Deskripsi singkat<input type="text" name="shortDescription" maxlength="220" value="<%= product?.shortDescription || '' %>"></label><label class="full">Deskripsi lengkap<textarea name="description" required rows="8" maxlength="8000"><%= product?.description || '' %></textarea></label><label>Kategori<input type="text" name="category" value="<%= product?.category || 'Umum' %>"></label><label>URL gambar<input type="text" name="imageUrl" value="<%= product?.imageUrl || '/images/product-placeholder.svg' %>"></label><label>Harga<input type="number" name="price" min="0" required value="<%= product?.price ?? 0 %>"></label><label>Diskon (%)<input type="number" name="discountPercent" min="0" max="100" value="<%= product?.discountPercent ?? 0 %>"></label><label>Stok<input type="number" name="stock" min="0" value="<%= product?.stock ?? 0 %>"></label><label>Tipe pengiriman<select name="deliveryType"><option value="digital" <%= product?.deliveryType !== 'physical' ? 'selected' : '' %>>Digital</option><option value="physical" <%= product?.deliveryType === 'physical' ? 'selected' : '' %>>Fisik</option></select></label><label>Harga flash sale<input type="number" name="flashSalePrice" min="0" value="<%= product?.flashSalePrice ?? '' %>"></label><label>Mulai flash sale<input type="datetime-local" name="flashSaleStart" value="<%= product?.flashSaleStart ? new Date(product.flashSaleStart).toISOString().slice(0,16) : '' %>"></label><label>Selesai flash sale<input type="datetime-local" name="flashSaleEnd" value="<%= product?.flashSaleEnd ? new Date(product.flashSaleEnd).toISOString().slice(0,16) : '' %>"></label><label class="full">Konten pemenuhan produk digital<textarea name="fulfillmentContent" rows="5" maxlength="8000" placeholder="Kode lisensi, tautan akses, atau instruksi yang hanya terlihat setelah pesanan selesai"><%= product?.fulfillmentContent || '' %></textarea></label><div class="full check-group"><label class="check-row"><input type="checkbox" name="isActive" <%= product ? (product.isActive ? 'checked' : '') : 'checked' %>><span>Produk aktif</span></label><label class="check-row"><input type="checkbox" name="isFeatured" <%= product?.isFeatured ? 'checked' : '' %>><span>Produk unggulan</span></label><label class="check-row"><input type="checkbox" name="isFlashSale" <%= product?.isFlashSale ? 'checked' : '' %>><span>Aktifkan flash sale</span></label></div><div class="full action-row"><button class="btn btn-primary" type="submit">Simpan Produk</button><a class="btn btn-ghost" href="/admin/products">Batal</a></div></form></div></section>
<%- include('../../partials/footer') %>
