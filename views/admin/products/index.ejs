<%- include('../../partials/header') %>
<section class="section page-section"><div class="container"><div class="admin-heading"><div><span class="eyebrow">ADMIN / PRODUK</span><h1>Kelola Produk</h1></div><a class="btn btn-primary" href="/admin/products/new">+ Tambah Produk</a></div><div class="table-card glass-card"><div class="responsive-table"><table><thead><tr><th>Produk</th><th>Harga</th><th>Stok</th><th>Promo</th><th>Status</th><th>Aksi</th></tr></thead><tbody><% products.forEach((product) => { %><tr><td><div class="table-product"><img src="<%= product.imageUrl || '/images/product-placeholder.svg' %>" alt=""><div><strong><%= product.name %></strong><small><%= product.category %> · /<%= product.slug %></small></div></div></td><td><%= formatRupiah(product.price) %></td><td><%= product.stock %></td><td><%= product.isFlashSale ? 'Flash Sale' : product.discountPercent ? `${product.discountPercent}%` : '-' %></td><td><span class="status-pill <%= product.isActive ? 'status-completed' : 'status-cancelled' %>"><%= product.isActive ? 'aktif' : 'nonaktif' %></span></td><td><div class="action-row"><a class="btn btn-ghost btn-sm" href="/admin/products/<%= product._id %>/edit">Edit</a><form method="post" action="/admin/products/<%= product._id %>?_method=DELETE"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm" type="submit">Nonaktifkan</button></form></div></td></tr><% }) %></tbody></table></div></div></div></section>
<%- include('../../partials/footer') %>
