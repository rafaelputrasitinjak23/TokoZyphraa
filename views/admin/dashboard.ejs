<%- include('../partials/header') %>
<section class="section page-section"><div class="container"><div class="admin-heading"><div><span class="eyebrow">ADMINISTRATOR</span><h1>Dashboard TokoZyphra</h1></div><div class="admin-links"><a class="btn btn-ghost btn-sm" href="/admin/products">Produk</a><a class="btn btn-ghost btn-sm" href="/admin/vouchers">Voucher</a><a class="btn btn-ghost btn-sm" href="/admin/orders">Pesanan</a><a class="btn btn-ghost btn-sm" href="/admin/users">Pengguna</a></div></div>
<div class="stats-grid admin-stats"><div class="stat-card glass-card"><span>Produk</span><strong><%= productCount %></strong></div><div class="stat-card glass-card"><span>Pengguna</span><strong><%= userCount %></strong></div><div class="stat-card glass-card"><span>Menunggu Bayar</span><strong><%= pendingCount %></strong></div><div class="stat-card glass-card"><span>Pesanan Selesai</span><strong><%= completedCount %></strong></div><div class="stat-card glass-card"><span>Omzet Terverifikasi</span><strong><%= formatRupiah(revenue) %></strong></div></div>
<div class="section-heading subheading"><div><h2>Pesanan Terbaru</h2></div><a href="/admin/orders">Kelola semua →</a></div><div class="table-card glass-card"><div class="responsive-table"><table><thead><tr><th>Pesanan</th><th>Pengguna</th><th>Tagihan</th><th>Status</th><th>Tanggal</th></tr></thead><tbody><% recentOrders.forEach((order) => { %><tr><td><%= order.orderNumber %></td><td><%= order.user?.name || '-' %><small class="table-sub"><%= order.user?.email || '' %></small></td><td><%= formatRupiah(order.payableAmount) %></td><td><span class="status-pill status-<%= order.status %>"><%= order.status %></span></td><td><%= formatDate(order.createdAt) %></td></tr><% }) %></tbody></table></div></div></div></section>
<%- include('../partials/footer') %>
