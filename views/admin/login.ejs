<%- include('../partials/header') %>
<section class="auth-section"><div class="auth-card glass-card"><div class="auth-heading"><span class="eyebrow danger">AREA ADMIN</span><h1>Login Administrator</h1><p>Akses ini hanya untuk pengelola TokoZyphra.</p></div><form method="post" action="/admin/login" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Email admin<input type="email" name="email" required autocomplete="username"></label><label>Kata sandi<input type="password" name="password" required autocomplete="current-password"></label><div class="captcha-field"><label>CAPTCHA<input type="text" name="captcha" required maxlength="10" autocomplete="off" placeholder="Ketik huruf pada gambar"></label><button class="captcha-image" type="button" data-captcha-refresh><img src="/auth/captcha/admin.svg" alt="CAPTCHA admin"></button></div><button class="btn btn-primary btn-block" type="submit">Masuk Admin</button></form></div></section>
<%- include('../partials/footer') %>
