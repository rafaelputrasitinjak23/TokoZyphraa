<%- include('../../partials/header') %>
<section class="section page-section"><div class="container"><div class="admin-heading"><div><span class="eyebrow">ADMIN / VOUCHER</span><h1>Kelola Voucher</h1></div><a class="btn btn-primary" href="/admin/vouchers/new">+ Tambah Voucher</a></div><div class="table-card glass-card"><div class="responsive-table"><table><thead><tr><th>Kode</th><th>Nilai</th><th>Minimal</th><th>Penggunaan</th><th>Berlaku sampai</th><th>Aksi</th></tr></thead><tbody><% vouchers.forEach((voucher) => { %><tr><td><strong class="voucher-chip"><%= voucher.code %></strong><small class="table-sub"><%= voucher.description %></small></td><td><%= voucher.type === 'percent' ? `${voucher.value}%` : formatRupiah(voucher.value) %></td><td><%= formatRupiah(voucher.minPurchase) %></td><td><%= voucher.usedCount %> / <%= voucher.usageLimit || '∞' %></td><td><%= formatDate(voucher.expiresAt) %></td><td><div class="action-row"><a class="btn btn-ghost btn-sm" href="/admin/vouchers/<%= voucher._id %>/edit">Edit</a><form method="post" action="/admin/vouchers/<%= voucher._id %>?_method=DELETE"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm" type="submit">Nonaktifkan</button></form></div></td></tr><% }) %></tbody></table></div></div><%- include('../../partials/pagination', { pagination }) %>
</div></section>
<%- include('../../partials/footer') %>
