<%- include('../../partials/header') %>
<section class="section page-section"><div class="container narrow-wide"><div class="section-heading"><div><span class="eyebrow">ADMIN / VOUCHER</span><h1><%= voucher ? 'Edit Voucher' : 'Tambah Voucher' %></h1></div></div><form method="post" action="<%= action %>" class="form-card glass-card form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Kode voucher<input type="text" name="code" required maxlength="40" value="<%= voucher?.code || '' %>"></label><label>Tipe<select name="type"><option value="percent" <%= voucher?.type !== 'fixed' ? 'selected' : '' %>>Persentase</option><option value="fixed" <%= voucher?.type === 'fixed' ? 'selected' : '' %>>Nominal tetap</option></select></label><label class="full">Deskripsi<input type="text" name="description" maxlength="180" value="<%= voucher?.description || '' %>"></label><label>Nilai<input type="number" name="value" min="0" required value="<%= voucher?.value ?? 0 %>"></label><label>Minimal pembelian<input type="number" name="minPurchase" min="0" value="<%= voucher?.minPurchase ?? 0 %>"></label><label>Maksimal diskon<input type="number" name="maxDiscount" min="0" value="<%= voucher?.maxDiscount ?? '' %>"></label><label>Kuota total<input type="number" name="usageLimit" min="1" value="<%= voucher?.usageLimit ?? '' %>"></label><label>Batas per pengguna<input type="number" name="perUserLimit" min="1" value="<%= voucher?.perUserLimit ?? 1 %>"></label><label>Mulai berlaku<input type="datetime-local" name="startsAt" value="<%= voucher?.startsAt ? new Date(voucher.startsAt).toISOString().slice(0,16) : '' %>"></label><label>Berakhir<input type="datetime-local" name="expiresAt" required value="<%= voucher?.expiresAt ? new Date(voucher.expiresAt).toISOString().slice(0,16) : '' %>"></label><div class="full check-group"><label class="check-row"><input type="checkbox" name="isActive" <%= voucher ? (voucher.isActive ? 'checked' : '') : 'checked' %>><span>Voucher aktif</span></label></div><div class="full action-row"><button class="btn btn-primary" type="submit">Simpan Voucher</button><a class="btn btn-ghost" href="/admin/vouchers">Batal</a></div></form></div></section>
<%- include('../../partials/footer') %>
