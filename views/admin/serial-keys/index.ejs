<%- include('../../partials/header') %>
<section class="section page-section">
  <div class="container">
    <div class="admin-heading"><div><span class="eyebrow">ADMIN / SERIAL KEY</span><h1><%= product.name %></h1><p>Serial key tersedia akan diberikan otomatis setelah pembayaran selesai.</p></div><a class="btn btn-ghost" href="/admin/products">Kembali ke Produk</a></div>
    <div class="stats-grid admin-stats"><div class="stat-card glass-card"><span>Tersedia</span><strong><%= summary.available %></strong></div><div class="stat-card glass-card"><span>Sudah diberikan</span><strong><%= summary.assigned %></strong></div><div class="stat-card glass-card"><span>Dinonaktifkan</span><strong><%= summary.disabled %></strong></div><div class="stat-card glass-card"><span>Stok produk</span><strong><%= product.stock %></strong></div></div>
    <div class="form-card glass-card">
      <h2>Tambah Serial Key</h2><p>Masukkan satu serial key per baris. Duplikat akan dilewati.</p>
      <form method="post" action="/admin/products/<%= product._id %>/serial-keys" class="form-stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Daftar serial key<textarea name="serialKeys" rows="10" maxlength="500000" required placeholder="XXXX-XXXX-XXXX&#10;YYYY-YYYY-YYYY"></textarea></label>
        <button class="btn btn-primary" type="submit">Tambahkan Serial Key</button>
      </form>
    </div>
    <div class="table-card glass-card"><div class="responsive-table"><table><thead><tr><th>Serial Key</th><th>Status</th><th>Pesanan</th><th>Pengguna</th><th>Tanggal</th><th>Aksi</th></tr></thead><tbody>
      <% keys.forEach((key) => { %><tr><td><code class="serial-key-code"><%= key.value %></code></td><td><span class="status-pill status-<%= key.status %>"><%= key.status %></span></td><td><%= key.order?.orderNumber || '-' %></td><td><%= key.user?.name || '-' %><small class="table-sub"><%= key.user?.email || '' %></small></td><td><%= formatDate(key.assignedAt || key.createdAt) %></td><td><% if (key.status === 'available') { %><form method="post" action="/admin/serial-keys/<%= key._id %>/disable" data-confirm="Nonaktifkan serial key ini?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button danger-text" type="submit">Nonaktifkan</button></form><% } else { %>-<% } %></td></tr><% }) %>
      <% if (!keys.length) { %><tr><td colspan="6">Belum ada serial key.</td></tr><% } %>
    </tbody></table></div></div>
  </div>
</section>
<%- include('../../partials/footer') %>
