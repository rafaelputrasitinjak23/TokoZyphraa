<%- include('../partials/header') %>
<section class="section page-section"><div class="container"><div class="admin-heading"><div><span class="eyebrow">ADMIN / ULASAN</span><h1>Moderasi Ulasan</h1></div></div><div class="review-list"><% reviews.forEach((review) => { %><article class="review-card glass-card"><div><div><strong><%= review.user?.name || 'Pengguna' %></strong><small class="table-sub"><%= review.product?.name || 'Produk' %></small></div><span class="stars"><%= '★'.repeat(review.rating) %><%= '☆'.repeat(5-review.rating) %></span></div><p><%= review.comment %></p><div class="order-card-foot"><small><%= formatDate(review.createdAt) %> · <%= review.isPublished ? 'ditampilkan' : 'disembunyikan' %></small><form method="post" action="/admin/reviews/<%= review._id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm" type="submit"><%= review.isPublished ? 'Sembunyikan' : 'Tampilkan' %></button></form></div></article><% }) %></div><%- include('../partials/pagination', { pagination }) %>
</div></section>
<%- include('../partials/footer') %>
