<%- include('../partials/header') %>
<section class="section page-section"><div class="container"><div class="admin-heading"><div><span class="eyebrow">ADMIN / PENGGUNA</span><h1>Kelola Pengguna & Dompet</h1></div></div><div class="user-admin-grid"><% users.forEach((user) => { %><article class="user-admin-card glass-card"><div class="user-admin-head"><div class="avatar"><%= user.name.slice(0,1).toUpperCase() %></div><div><h3><%= user.name %></h3><p><%= user.email %></p></div><span class="status-pill <%= user.isActive ? 'status-completed' : 'status-cancelled' %>"><%= user.isActive ? 'aktif' : 'nonaktif' %></span></div><div class="wallet-balance"><span>Saldo dompet</span><strong><%= formatRupiah(user.walletBalance) %></strong></div><form method="post" action="/admin/users/<%= user._id %>/wallet" class="wallet-adjust-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="adjustmentToken" value="<%= user.adjustmentToken %>"><select name="type"><option value="credit">Tambah saldo</option><option value="debit">Kurangi saldo</option></select><input type="number" name="amount" min="1" max="100000000" required placeholder="Nominal"><input type="text" name="note" maxlength="500" placeholder="Catatan"><button class="btn btn-primary btn-sm" type="submit">Proses</button></form><form method="post" action="/admin/users/<%= user._id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button <%= user.isActive ? 'danger-text' : '' %>" type="submit"><%= user.isActive ? 'Nonaktifkan akun' : 'Aktifkan akun' %></button></form></article><% }) %></div><%- include('../partials/pagination', { pagination }) %>
</div></section>
<%- include('../partials/footer') %>
