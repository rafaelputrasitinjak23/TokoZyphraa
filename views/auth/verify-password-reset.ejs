<%- include('../partials/header') %>
<section class="auth-section">
  <div class="auth-card glass-card small-card">
    <%- include('../partials/auth-logo') %>
    <div class="auth-heading">
      <span class="eyebrow">VERIFIKASI RESET</span>
      <h1>Masukkan kode OTP</h1>
      <p>Jika email <strong><%= email %></strong> terdaftar, kode enam digit telah dikirim ke alamat tersebut.</p>
    </div>
    <form method="post" action="/auth/verify-password-reset" class="form-stack" data-disable-on-submit>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Kode OTP
        <input class="otp-input" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" name="otp" required autocomplete="one-time-code" placeholder="000000">
      </label>
      <button class="btn btn-primary btn-block" type="submit">Verifikasi kode</button>
    </form>
    <form method="post" action="/auth/resend-password-reset-otp" class="center-form" data-disable-on-submit>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="text-button" type="submit">Kirim ulang OTP</button>
    </form>
    <p class="auth-switch"><a href="/auth/forgot-password">Gunakan email lain</a></p>
  </div>
</section>
<%- include('../partials/footer') %>
