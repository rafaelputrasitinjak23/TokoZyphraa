<%- include('../partials/header') %>
<section class="auth-section">
  <div class="auth-card glass-card small-card">
    <%- include('../partials/auth-logo') %>
    <div class="auth-heading">
      <span class="eyebrow">PEMULIHAN AKUN</span>
      <h1>Lupa kata sandi?</h1>
      <p>Masukkan email akun Anda. Kami akan mengirim kode OTP untuk memverifikasi permintaan reset.</p>
    </div>
    <form method="post" action="/auth/forgot-password" class="form-stack" data-disable-on-submit>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Email
        <input type="email" name="email" required autocomplete="email" placeholder="nama@email.com">
      </label>
      <div class="captcha-block">
        <div class="captcha-preview-row">
          <div class="captcha-image"><img src="/auth/captcha/forgot.svg" alt="Kode CAPTCHA reset kata sandi"></div>
          <button class="captcha-refresh" type="button" data-captcha-refresh>Ganti kode</button>
        </div>
        <label class="captcha-label">Ketik kode yang terlihat
          <input class="captcha-input" type="text" name="captcha" required minlength="5" maxlength="5" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="CONTOH: A7K9P">
        </label>
        <p class="captcha-help">Ganti kode jika tulisan sulit dibaca.</p>
      </div>
      <button class="btn btn-primary btn-block" type="submit">Kirim kode OTP</button>
    </form>
    <p class="auth-switch">Sudah ingat kata sandi? <a href="/auth/login">Kembali masuk</a></p>
  </div>
</section>
<%- include('../partials/footer') %>
