<%- include('../partials/header') %>
<section class="auth-section">
  <div class="auth-card glass-card">
    <%- include('../partials/auth-logo') %>
    <div class="auth-heading"><span class="eyebrow">AKUN BARU</span><h1>Daftar TokoRafael</h1><p></p></div>
    <form method="post" action="/auth/register" class="form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Nama lengkap<input type="text" name="name" required minlength="2" maxlength="80" autocomplete="name" placeholder="Nama Anda"></label>
      <label>Email<input type="email" name="email" required autocomplete="email" placeholder="nama@email.com"></label>
      <label>Kata sandi<input type="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password" placeholder="Minimal 8 karakter, huruf dan angka"></label>
      <label>Konfirmasi kata sandi<input type="password" name="passwordConfirm" required minlength="8" maxlength="72" autocomplete="new-password" placeholder="Ulangi kata sandi"></label>
      <label>Kode referral <span class="optional-label">opsional</span><input type="text" name="referralCode" maxlength="24" value="<%= referralCode || '' %>" autocomplete="off" placeholder="Contoh: RAFAEL12AB34"></label>
      <div class="captcha-block">
        <div class="captcha-preview-row">
          <div class="captcha-image"><img src="/auth/captcha/register.svg" alt="Kode CAPTCHA registrasi"></div>
          <button class="captcha-refresh" type="button" data-captcha-refresh>Ganti kode</button>
        </div>
        <label class="captcha-label">Ketik kode yang terlihat
          <input class="captcha-input" type="text" name="captcha" required minlength="5" maxlength="5" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="CONTOH: A7K9P">
        </label>
        <p class="captcha-help">Ganti kode jika tulisan sulit dibaca.</p>
      </div>
      <button class="btn btn-primary btn-block" type="submit">Kirim OTP Registrasi</button>
    </form>
    <p class="auth-switch">Sudah memiliki akun? <a href="/auth/login">Masuk</a></p>
  </div>
</section>
<%- include('../partials/footer') %>
