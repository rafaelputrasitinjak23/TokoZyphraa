<%- include('../partials/header') %>
<section class="auth-section">
  <div class="auth-card glass-card small-card">
    <div class="auth-heading"><span class="eyebrow">VERIFIKASI EMAIL</span><h1>Masukkan kode OTP</h1><p>Kode enam digit telah dikirim ke <strong><%= email %></strong>.</p></div>
    <form method="post" action="/auth/verify-registration" class="form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Kode OTP<input class="otp-input" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" name="otp" required autocomplete="one-time-code" placeholder="000000"></label>
      <button class="btn btn-primary btn-block" type="submit">Verifikasi & Buat Akun</button>
    </form>
    <form method="post" action="/auth/resend-registration-otp" class="center-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="text-button" type="submit">Kirim ulang OTP</button>
    </form>
  </div>
</section>
<%- include('../partials/footer') %>
