<%- include('../partials/header') %>
<section class="section page-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">RIWAYAT</span><h1>Pesanan Saya</h1></div></div>
<% if (orders.length) { %><div class="order-grid"><% orders.forEach((order) => { %><article class="order-card glass-card"><div class="order-card-head"><div><small><%= formatDate(order.createdAt) %></small><h3><%= order.orderNumber %></h3></div><span class="status-pill status-<%= order.status %>"><%= order.status %></span></div><div class="order-items-preview"><% order.items.slice(0,3).forEach((item) => { %><div><img src="<%= item.imageUrl || '/images/product-placeholder.svg' %>" alt=""><span><%= item.name %> × <%= item.quantity %></span></div><% }) %></div><div class="order-card-foot"><div><small>Total tagihan</small><strong><%= formatRupiah(order.payableAmount) %></strong></div><a class="btn btn-ghost btn-sm" href="/account/orders/<%= order.orderNumber %>">Lihat Detail</a></div></article><% }) %></div><% } else { %><div class="empty-state glass-card"><h2>Belum ada pesanan</h2><a class="btn btn-primary" href="/">Belanja Sekarang</a></div><% } %>
</div></section>
<%- include('../partials/footer') %>
