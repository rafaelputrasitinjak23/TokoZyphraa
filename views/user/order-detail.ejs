<%- include('../partials/header') %>
<section class="section page-section">
  <div class="container narrow-wide">
    <div class="section-heading">
      <div><span class="eyebrow">DETAIL PESANAN</span><h1><%= order.orderNumber %></h1><p>Dibuat <%= formatDate(order.createdAt) %></p></div>
      <span class="status-pill status-<%= order.status %>"><%= order.status %></span>
    </div>
    <div class="detail-content-grid">
      <div class="form-card glass-card">
        <h2>Produk</h2>
        <div class="order-detail-items">
          <% order.items.forEach((item, itemIndex) => { %>
            <article>
              <img src="<%= item.imageUrl || '/images/product-placeholder.svg' %>" alt="<%= item.name %>">
              <div>
                <a href="/products/<%= item.slug %>"><strong><%= item.name %></strong></a>
                <span><%= item.quantity %> × <%= formatRupiah(item.unitPrice) %></span>
                <% if (order.status === 'completed' && item.deliveryType !== 'physical') { %>
                  <div class="fulfillment-box digital-delivery-box">
                    <strong>Akses Produk Digital</strong>
                    <% if (item.fulfillmentContent) { %><div class="preline"><%= item.fulfillmentContent %></div><% } %>
                    <% if (item.serialKeys?.length) { %>
                      <div class="serial-key-list"><span>Serial key</span><% item.serialKeys.forEach((serial) => { %><code><%= serial %></code><% }) %></div>
                    <% } %>
                    <% if (item.digitalAsset && ['local', 'url'].includes(item.digitalAsset.type)) { %>
                      <a class="btn btn-primary btn-sm btn-icon-label" href="/account/downloads/<%= order.orderNumber %>/<%= itemIndex %>"><svg class="svg-icon" aria-hidden="true"><use href="#icon-download"></use></svg><span><%= item.digitalAsset.type === 'url' ? 'Buka File Digital' : 'Unduh File Digital' %></span></a>
                      <small><%= item.digitalAsset.downloadLimit > 0 ? `${item.digitalAsset.downloadCount || 0}/${item.digitalAsset.downloadLimit} akses digunakan` : 'Unduhan tanpa batas' %></small>
                    <% } %>
                  </div>
                <% } %>
                <% if (order.status === 'completed' && !reviewed.has(String(item.product))) { %>
                  <details class="review-form">
                    <summary>Beri ulasan</summary>
                    <form method="post" action="/account/reviews/<%= item.product %>" class="form-stack">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <label>Rating<select name="rating" required><option value="5">5 - Sangat baik</option><option value="4">4 - Baik</option><option value="3">3 - Cukup</option><option value="2">2 - Kurang</option><option value="1">1 - Buruk</option></select></label>
                      <label>Ulasan<textarea name="comment" required minlength="5" maxlength="1500" placeholder="Ceritakan pengalaman Anda"></textarea></label>
                      <button class="btn btn-primary btn-sm" type="submit">Kirim Ulasan</button>
                    </form>
                  </details>
                <% } %>
              </div>
              <strong><%= formatRupiah(item.lineTotal) %></strong>
            </article>
          <% }) %>
        </div>
        <% if (order.shippingAddress) { %>
          <div class="fulfillment-box">
            <strong>Alamat Pengiriman</strong>
            <div class="preline"><%= order.shippingAddress.receiverName %> · <%= order.shippingAddress.phone %>
<%= order.shippingAddress.address %>
<%= order.shippingAddress.city %>, <%= order.shippingAddress.postalCode %></div>
          </div>
        <% } %>
      </div>
      <aside class="summary-card glass-card">
        <h2>Rincian Biaya</h2>
        <div class="summary-line"><span>Subtotal</span><strong><%= formatRupiah(order.subtotal) %></strong></div>
        <div class="summary-line"><span>Diskon</span><strong>-<%= formatRupiah(order.discountAmount) %></strong></div>
        <div class="summary-line"><span>Dompet</span><strong>-<%= formatRupiah(order.walletUsed) %></strong></div>
        <div class="summary-line total"><span>Tagihan</span><strong><%= formatRupiah(order.payableAmount) %></strong></div>
        <% if (order.voucherCode) { %><p class="voucher-chip">Voucher: <%= order.voucherCode %></p><% } %>
        <a class="btn btn-ghost btn-block" href="/account/tickets/new?order=<%= order.orderNumber %>">Butuh Bantuan / Komplain</a>
        <% if (order.status === 'pending' && order.payableAmount > 0) { %>
          <a class="btn btn-primary btn-block" href="/checkout/payment/<%= order.orderNumber %>">Lanjutkan Pembayaran</a>
          <form method="post" action="/account/orders/<%= order.orderNumber %>/cancel" data-confirm="Batalkan pesanan ini?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-danger btn-block" type="submit">Batalkan Pesanan</button>
          </form>
        <% } %>
      </aside>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
