<%- include('../partials/header') %>
<section class="section page-section"><div class="container"><div class="wallet-hero glass-card"><div><span class="eyebrow">DOMPET ZYPHRA</span><h1><%= formatRupiah(user.walletBalance) %></h1><p>Saldo dapat digunakan otomatis saat checkout.</p></div><div class="wallet-icon">Z</div></div><div class="section-heading subheading"><div><h2>Riwayat Transaksi</h2></div></div>
<% if (transactions.length) { %><div class="table-card glass-card"><div class="responsive-table"><table><thead><tr><th>Tanggal</th><th>Keterangan</th><th>Referensi</th><th>Nominal</th><th>Saldo</th></tr></thead><tbody><% transactions.forEach((tx) => { %><tr><td><%= formatDate(tx.createdAt) %></td><td><%= tx.note || tx.source %></td><td><%= tx.reference || '-' %></td><td class="<%= tx.type === 'credit' ? 'amount-credit' : 'amount-debit' %>"><%= tx.type === 'credit' ? '+' : '-' %><%= formatRupiah(tx.amount) %></td><td><%= formatRupiah(tx.balanceAfter) %></td></tr><% }) %></tbody></table></div></div><% } else { %><div class="empty-state glass-card"><p>Belum ada transaksi dompet.</p></div><% } %></div></section>
<%- include('../partials/footer') %>
