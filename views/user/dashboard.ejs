<%- include('../partials/header') %>
<%
  const statusLabels = {
    pending: 'MENUNGGU DIBAYAR',
    paid: 'DIBAYAR',
    processing: 'DIPROSES',
    completed: 'SELESAI',
    cancelled: 'DIBATALKAN',
    expired: 'KEDALUWARSA',
    manual_review: 'DIPERIKSA'
  };
%>
<section class="section page-section account-dashboard-page account-profile-dashboard">
  <div class="container account-profile-container">
    <article class="account-profile-hero glass-card">
      <div class="account-profile-avatar" aria-label="Foto profil <%= user.name %>">
        <% if (currentUser?.hasAvatar) { %>
          <img src="/account/avatar" alt="Foto profil <%= user.name %>">
        <% } else { %>
          <span><%= user.name.slice(0, 1).toUpperCase() %></span>
        <% } %>
      </div>

      <span class="account-profile-kicker">AKUN SAYA</span>
      <h1><%= user.name %></h1>

      <div class="account-profile-badges">
        <% if (user.emailVerifiedAt) { %>
          <span class="account-verified-badge">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-check-circle"></use></svg>
            Email terverifikasi
          </span>
        <% } else { %>
          <span class="account-verified-badge account-unverified-badge">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-clock"></use></svg>
            Email belum terverifikasi
          </span>
        <% } %>
      </div>

      <p class="account-profile-description">
        <%= user.bio || 'Kelola belanja, produk digital, dan pengaturan akun Anda dari satu tempat.' %>
      </p>

      <dl class="account-profile-meta">
        <div>
          <dt><svg class="svg-icon" aria-hidden="true"><use href="#icon-mail"></use></svg></dt>
          <dd><%= user.email %></dd>
        </div>
        <div>
          <dt><svg class="svg-icon" aria-hidden="true"><use href="#icon-calendar"></use></svg></dt>
          <dd>Bergabung <%= formatDate(user.createdAt) %></dd>
        </div>
      </dl>

      <div class="account-profile-actions">
        <a class="account-profile-primary-action" href="/account/profile">
          <svg class="svg-icon" aria-hidden="true"><use href="#icon-edit"></use></svg>
          <span>Edit profil</span>
        </a>
        <a class="account-profile-secondary-action" href="/#catalog">
          <svg class="svg-icon" aria-hidden="true"><use href="#icon-store"></use></svg>
          <span>Belanja produk</span>
        </a>
      </div>
    </article>

    <section class="account-summary-grid" aria-label="Ringkasan akun">
      <a class="account-summary-card glass-card" href="/account/orders">
        <span class="account-summary-icon account-summary-icon-purple">
          <svg class="svg-icon" aria-hidden="true"><use href="#icon-receipt"></use></svg>
        </span>
        <span class="account-summary-copy">
          <small>Total pesanan</small>
          <strong><%= purchaseStats.totalOrders %></strong>
        </span>
      </a>

      <a class="account-summary-card glass-card" href="/account/orders">
        <span class="account-summary-icon account-summary-icon-green">
          <svg class="svg-icon" aria-hidden="true"><use href="#icon-check-circle"></use></svg>
        </span>
        <span class="account-summary-copy">
          <small>Pesanan selesai</small>
          <strong><%= purchaseStats.completedOrders %></strong>
        </span>
      </a>

      <a class="account-summary-card glass-card" href="/account/orders">
        <span class="account-summary-icon account-summary-icon-orange">
          <svg class="svg-icon" aria-hidden="true"><use href="#icon-clock"></use></svg>
        </span>
        <span class="account-summary-copy">
          <small>Menunggu dibayar</small>
          <strong><%= purchaseStats.pendingOrders %></strong>
        </span>
      </a>

      <a class="account-summary-card glass-card" href="/account/orders">
        <span class="account-summary-icon account-summary-icon-blue">
          <svg class="svg-icon" aria-hidden="true"><use href="#icon-package"></use></svg>
        </span>
        <span class="account-summary-copy">
          <small>Produk dimiliki</small>
          <strong><%= purchaseStats.totalProducts %></strong>
        </span>
      </a>
    </section>

    <section class="loyalty-referral-grid" id="loyalty">
      <article class="loyalty-card glass-card">
        <div class="panel-heading"><div><span class="eyebrow">LOYALTY POINT</span><h2><%= user.loyaltyPoints || 0 %> poin</h2></div><svg class="svg-icon feature-card-icon" aria-hidden="true"><use href="#icon-star"></use></svg></div>
        <p>Dapatkan 1 poin untuk setiap Rp1.000 nilai transaksi. Setiap 100 poin dapat ditukar menjadi saldo Rp1.000.</p>
        <form method="post" action="/account/loyalty/redeem" class="loyalty-redeem-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="redeemToken" value="<%= redeemToken %>">
          <input type="number" name="points" min="100" step="100" max="<%= user.loyaltyPoints || 0 %>" placeholder="Jumlah poin" required>
          <button class="btn btn-primary btn-sm" type="submit" <%= (user.loyaltyPoints || 0) < 100 ? 'disabled' : '' %>>Tukar ke Saldo</button>
        </form>
        <a class="text-link" href="/account/loyalty/history">Lihat riwayat poin</a>
      </article>
      <article class="referral-card glass-card">
        <div class="panel-heading"><div><span class="eyebrow">REFERRAL</span><h2>Undang teman</h2></div><svg class="svg-icon feature-card-icon" aria-hidden="true"><use href="#icon-gift"></use></svg></div>
        <p>Dapatkan 100 poin setelah teman yang mendaftar dengan kode Anda menyelesaikan transaksi pertamanya.</p>
        <div class="referral-code-box"><code><%= user.referralCode || '-' %></code><button class="btn btn-ghost btn-sm" type="button" data-copy="<%= user.referralCode || '' %>">Salin kode</button></div>
        <div class="referral-stats"><span><strong><%= referralStats.total %></strong> terdaftar</span><span><strong><%= referralStats.rewarded %></strong> menghasilkan bonus</span></div>
      </article>
    </section>

    <section class="account-activity-card glass-card">
      <header class="account-activity-header">
        <div>
          <span>AKTIVITAS</span>
          <h2>Pesanan terbaru</h2>
        </div>
        <a href="/account/orders">Lihat semua</a>
      </header>

      <% if (recentOrders.length) { %>
        <div class="account-order-list">
          <% recentOrders.forEach((order) => { %>
            <% const productCount = (order.items || []).reduce((total, item) => total + Number(item.quantity || 0), 0); %>
            <a class="account-order-item" href="/account/orders/<%= order.orderNumber %>">
              <span class="account-order-icon">
                <svg class="svg-icon" aria-hidden="true"><use href="#icon-receipt"></use></svg>
              </span>

              <span class="account-order-content">
                <span class="account-order-title"><%= order.orderNumber %></span>
                <span class="account-order-meta"><%= productCount %> produk · <%= formatDate(order.createdAt) %></span>
                <span class="account-order-payment">
                  <strong><%= formatRupiah(Number(order.payableAmount || 0) + Number(order.walletUsed || 0)) %></strong>
                  <span class="status-pill status-<%= order.status %>"><%= statusLabels[order.status] || String(order.status || '').toUpperCase() %></span>
                </span>
              </span>

              <svg class="svg-icon account-order-arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="account-activity-empty">
          <span class="account-order-icon">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-package"></use></svg>
          </span>
          <h3>Belum ada pesanan</h3>
          <p>Pesanan yang Anda buat akan muncul di bagian ini.</p>
          <a class="btn btn-primary btn-icon-label" href="/#catalog">
            <svg class="svg-icon" aria-hidden="true"><use href="#icon-store"></use></svg>
            <span>Mulai Belanja</span>
          </a>
        </div>
      <% } %>
    </section>
  </div>
</section>
<%- include('../partials/footer') %>
