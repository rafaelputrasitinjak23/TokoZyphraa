<%- include('../partials/header') %>
<section class="section page-section">
  <div class="container">
    <div class="section-heading"><div><span class="eyebrow">AKUN SAYA</span><h1>Halo, <%= user.name %></h1><p>Kelola pesanan dan saldo dompet Anda dari satu tempat.</p></div></div>
    <div class="stats-grid">
      <div class="stat-card glass-card"><span>Total Pesanan</span><strong><%= orderCount %></strong><a href="/account/orders">Lihat semua</a></div>
      <div class="stat-card glass-card"><span>Saldo Dompet</span><strong><%= formatRupiah(user.walletBalance) %></strong><a href="/account/wallet">Riwayat saldo</a></div>
      <div class="stat-card glass-card"><span>Status Email</span><strong><%= user.emailVerifiedAt ? 'Terverifikasi' : 'Belum' %></strong><small><%= user.email %></small></div>
    </div>
    <div class="section-heading subheading"><div><h2>Pesanan Terbaru</h2></div><a class="text-link" href="/account/orders">Semua pesanan →</a></div>
    <% if (recentOrders.length) { %>
      <div class="table-card glass-card"><div class="responsive-table"><table><thead><tr><th>Pesanan</th><th>Tanggal</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody><% recentOrders.forEach((order) => { %><tr><td><strong><%= order.orderNumber %></strong></td><td><%= formatDate(order.createdAt) %></td><td><%= formatRupiah(order.payableAmount) %></td><td><span class="status-pill status-<%= order.status %>"><%= order.status %></span></td><td><a href="/account/orders/<%= order.orderNumber %>">Detail</a></td></tr><% }) %></tbody></table></div></div>
    <% } else { %><div class="empty-state glass-card"><p>Belum ada pesanan.</p><a class="btn btn-primary" href="/">Mulai Belanja</a></div><% } %>
  </div>
</section>
<%- include('../partials/footer') %>
